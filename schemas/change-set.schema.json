{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-engineering/change-set.schema.json",
  "title": "Agentic Engineering Change Set",
  "type": "object",
  "required": ["summary", "operations"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "additionalProperties": false,
        "properties": {
          "op": {"enum": ["write", "delete"]},
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"op": {"const": "write"}}},
            "then": {"required": ["content"]}
          }
        ]
      }
    }
  }
}
