{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-engineering/remediation-plan.schema.json",
  "title": "Bounded remediation plan",
  "type": "object",
  "required": [
    "plan_id",
    "work_item_id",
    "planner",
    "tool_name",
    "execution_mode",
    "steps",
    "validation_checks",
    "fallback",
    "max_retries",
    "source_repository_mutation",
    "created_at"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^PLAN-"},
    "work_item_id": {"type": "string", "pattern": "^WORK-"},
    "planner": {"type": "string"},
    "tool_name": {"const": "mock_remediation"},
    "execution_mode": {"enum": ["dry_run", "mock"]},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "fallback": {"type": "string"},
    "max_retries": {"type": "integer", "minimum": 1},
    "source_repository_mutation": {"const": false},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
